function(mars_bp3_coarse_support reason library)
    set(${reason} "" PARENT_SCOPE)
    set(${library} "" PARENT_SCOPE)
    find_path(_include HYPRE_config.h PATHS ${HYPRE_INCLUDE_DIRS} NO_DEFAULT_PATH NO_CACHE)
    if(NOT _include)
        set(${reason} "Hypre configuration header is missing" PARENT_SCOPE)
        return()
    endif()
    file(READ "${_include}/HYPRE_config.h" _config)
    if(NOT _config MATCHES "(^|\n)[ \t]*#define HYPRE_RELEASE_NUMBER[ \t]+23300([ \r\n]|$)"
       OR NOT _config MATCHES "(^|\n)[ \t]*#define HYPRE_USING_CUDA([ \r\n]|$)")
        set(${reason} "requires CUDA-enabled Hypre 2.33.0 headers" PARENT_SCOPE)
        return()
    endif()
    foreach(_mode HYPRE_SINGLE HYPRE_LONG_DOUBLE HYPRE_COMPLEX HYPRE_BIGINT)
        if(_config MATCHES "(^|\n)[ \t]*#define ${_mode}([ \r\n]|$)")
            set(${reason} "requires real FP64 and 32-bit local Hypre indices" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(_candidates ${HYPRE_LIBRARIES})
    list(FILTER _candidates INCLUDE REGEX "/lib(HYPRE|hypre)[.-]")
    list(LENGTH _candidates _count)
    if(NOT _count EQUAL 1)
        set(${reason} "requires one resolved Hypre library path" PARENT_SCOPE)
        return()
    endif()
    list(GET _candidates 0 _library)
    if(NOT _library MATCHES "\\.so(\\.|$)")
        set(${reason} "requires shared Hypre with replaceable callbacks" PARENT_SCOPE)
        return()
    endif()
    find_program(_mars_bp3_readelf NAMES readelf llvm-readelf)
    if(NOT _mars_bp3_readelf)
        set(${reason} "readelf is unavailable" PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND "${_mars_bp3_readelf}" -rW "${_library}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _relocations ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        set(${reason} "cannot inspect Hypre callback relocations: ${_error}" PARENT_SCOPE)
        return()
    endif()
    foreach(_callback hypre_seqAMGSetup hypre_seqAMGCycle)
        if(NOT _relocations MATCHES "[^\n]*(JUMP_SLOT|GLOB_DAT)[^\n]*${_callback}([ \n]|$)")
            set(${reason} "Hypre does not expose a replaceable ${_callback} callback" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${library} "${_library}" PARENT_SCOPE)
endfunction()

    add_executable(mars_simple_exodus_host_gate "${_dsimple_gates}/exodus_gate.cpp")
    target_include_directories(mars_simple_exodus_host_gate PRIVATE "${_dsimple_segregated}" "${MARS_SIMPLE_NETCDF_INCLUDE_DIR}")
    target_compile_features(mars_simple_exodus_host_gate PRIVATE cxx_std_20)

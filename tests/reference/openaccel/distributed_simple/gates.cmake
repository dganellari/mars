_dsimple_test(marsSimpleConfiguredShearReference 1 --write-reference ${_ref}-configured-shear.bin --configured 1 --mesh 8x2x2 --backflow -1 --iterations 12)
set_tests_properties(marsSimpleConfiguredReference marsSimpleConfiguredShearReference PROPERTIES FIXTURES_SETUP configured_references)

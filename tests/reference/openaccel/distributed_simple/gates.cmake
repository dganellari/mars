# Limiter history, boundary samples and nonzero reconstruction across partitions.
add_executable(mars_simple_high_resolution_check "${_dsimple_gates}/high_resolution_check.cpp")
target_include_directories(mars_simple_high_resolution_check PRIVATE "${_dsimple_segregated}")
target_compile_features(mars_simple_high_resolution_check PRIVATE cxx_std_20)
add_test(NAME marsSimpleHighResolutionAlgebra COMMAND mars_simple_high_resolution_check)
foreach(_case ordinary shear)
    set(_hr_args --high-resolution 1 --mesh 8x2x2 --iterations 12)
    if(_case STREQUAL shear)
        list(APPEND _hr_args --configured 1 --backflow -1)
    endif()
    _dsimple_test(marsSimpleHighResolutionReference_${_case} 1 --write-reference ${_ref}-hr-${_case}.bin ${_hr_args})
    set_tests_properties(marsSimpleHighResolutionReference_${_case} PROPERTIES FIXTURES_SETUP high_resolution_${_case})
    foreach(_ranks 1 2 4)
        _dsimple_test(marsSimpleHighResolution_${_case}_${_ranks} ${_ranks} --reference ${_ref}-hr-${_case}.bin --builder 1 ${_hr_args})
        set_tests_properties(marsSimpleHighResolution_${_case}_${_ranks} PROPERTIES FIXTURES_REQUIRED high_resolution_${_case})
        _dsimple_test(marsSimpleHighResolutionSynchronous_${_case}_${_ranks} ${_ranks} --reference ${_ref}-hr-${_case}.bin --builder 1 --halo-overlap 0 ${_hr_args})
        set_tests_properties(marsSimpleHighResolutionSynchronous_${_case}_${_ranks} PROPERTIES FIXTURES_REQUIRED high_resolution_${_case})
    endforeach()
endforeach()

# Shifted velocity interpolation changes assembly and reconstruction together.
foreach(_case upwind high_resolution)
    set(_shift_args --mesh 8x2x2 --iterations 12 --configured 1 --backflow -1 --velocity-interpolation linear-linear)
    if(_case STREQUAL high_resolution)
        list(APPEND _shift_args --high-resolution 1)
    endif()
    _dsimple_test(marsSimpleShiftedReference_${_case} 1 --write-reference ${_ref}-shift-${_case}.bin ${_shift_args})
    set_tests_properties(marsSimpleShiftedReference_${_case} PROPERTIES FIXTURES_SETUP shifted_${_case})
    foreach(_ranks 1 2 4)
        _dsimple_test(marsSimpleShifted_${_case}_${_ranks} ${_ranks} --reference ${_ref}-shift-${_case}.bin --builder 1 ${_shift_args})
        set_tests_properties(marsSimpleShifted_${_case}_${_ranks} PROPERTIES FIXTURES_REQUIRED shifted_${_case})
    endforeach()
endforeach()

foreach(_interpolation trilinear linear-linear)

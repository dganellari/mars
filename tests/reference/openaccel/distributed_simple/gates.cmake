            $<TARGET_FILE:mars_simple_exodus_host_gate> ${MPIEXEC_POSTFLAGS} "${CMAKE_CURRENT_BINARY_DIR}/exodus-fixtures-${_ranks}" "${_dsimple_root}/tests/data/public_outlet_channel/outlet_channel.exo")

    _dsimple_test(marsSimpleConfiguredShear_${_ranks} ${_ranks} --reference ${_ref}-configured-shear.bin --configured 1 --mesh 8x2x2 --backflow -1 --iterations 12 --builder 1)
    set_tests_properties(marsSimpleConfigured_${_ranks} marsSimpleConfiguredShear_${_ranks} PROPERTIES FIXTURES_REQUIRED configured_references)

function(bp3_policy_targets)
    set(private "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/private")
    if(NOT TARGET mars_bp3_coarse)
        message(FATAL_ERROR "Policy comparison requires the default AUTO adapter")
    endif()
    get_target_property(hypre_includes mars_bp3_coarse INCLUDE_DIRECTORIES)
    add_library(bp3_policy_adapter OBJECT "${private}/solvers/mars_cellwise_amg_consolidate.cu")
    target_include_directories(bp3_policy_adapter PRIVATE ${hypre_includes})
    target_compile_definitions(bp3_policy_adapter PRIVATE BP3_CONSOLIDATE_CUDA)
    target_link_libraries(bp3_policy_adapter PRIVATE MPI::MPI_CXX CUDA::cudart)
    target_compile_options(bp3_policy_adapter PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=-Wall,-Wextra,-Werror>)
    add_executable(bp3_policy_solver "${private}/driver/mars_marsir_bp.cu")
    target_sources(bp3_policy_solver PRIVATE $<TARGET_OBJECTS:bp3_policy_adapter>)
    target_compile_definitions(bp3_policy_solver PRIVATE MARS_BP3_COARSE_CONSOLIDATION)
    target_link_libraries(bp3_policy_solver PRIVATE mars CUDA::cuda_driver)
    add_executable(bp3_policy_fixture "${private}/fixture.cu")
    target_include_directories(bp3_policy_fixture PRIVATE "${private}" ${hypre_includes})
    target_compile_definitions(bp3_policy_fixture PRIVATE BP3_CONSOLIDATE_CUDA)
    target_link_libraries(bp3_policy_fixture PRIVATE MPI::MPI_CXX "${HYPRE_LIBRARY}" CUDA::cudart)
    target_compile_options(bp3_policy_fixture PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=-Wall,-Wextra,-Werror>)
    foreach(target bp3_policy_solver bp3_policy_fixture)
        target_link_options(${target} PRIVATE -Wl,--export-dynamic)
        set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/policy")
    endforeach()
    foreach(target bp3_policy_adapter bp3_policy_solver bp3_policy_fixture)
        set_target_properties(${target} PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
    endforeach()
endfunction()

# Run after MARS has defined its normal targets and dependencies.
cmake_language(DEFER CALL bp3_policy_targets)
